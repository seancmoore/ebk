rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = the (unique) display name "seanzie". Display names are enforced
    // unique via the usernames registry, so this identifies exactly one account.
    function isAdmin() {
      return request.auth != null && request.auth.token.name == 'seanzie';
    }
    function signedIn() {
      return request.auth != null;
    }
    // server-stamped `updated` + a minimum interval between writes
    // (rate limiting). Tolerates legacy docs whose `updated` was a number.
    function stampedAndThrottled() {
      return request.resource.data.updated == request.time
        && (!('updated' in resource.data)
            || !(resource.data.updated is timestamp)
            || request.time.toMillis() - resource.data.updated.toMillis() >= 2000);
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // unique display-name registry. lc/iv = the account email encrypted with
    // the user's password (enables username sign-in; unreadable without it).
    // uid/name immutable after create => uniqueness claims stay atomic.
    match /usernames/{nameKey} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && nameKey.size() >= 2 && nameKey.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'name', 'created', 'lc', 'iv']));
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lc', 'iv'])
        && request.resource.data.lc is string && request.resource.data.lc.size() <= 400
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 40);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // one doc per user per (sport, game): best + aggregates. Owner-only writes,
    // public reads; admins may edit any (for name changes). Writes are
    // validated (sane sizes, monotonic best, plays +1) and rate-limited.
    match /scores/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.sport + '_' + request.resource.data.game
        && request.resource.data.sport is string && request.resource.data.sport.size() <= 12
        && request.resource.data.game is string && request.resource.data.game.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.best is number
        && request.resource.data.best >= 0 && request.resource.data.best <= 100000
        && request.resource.data.plays == 1
        && request.resource.data.sumScore is number
        && request.resource.data.sumScore >= 0 && request.resource.data.sumScore <= 100000
        && request.resource.data.updated == request.time);
      allow update: if isAdmin()
        // owner renaming themselves: only the name field may change
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 40)
        // owner recording a finished run
        || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && resource.data.uid == request.auth.uid
            && request.resource.data.sport == resource.data.sport
            && request.resource.data.game == resource.data.game
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.best is number
            && request.resource.data.best >= resource.data.best
            && request.resource.data.best <= 100000
            && request.resource.data.plays == resource.data.plays + 1
            && request.resource.data.sumScore is number
            && request.resource.data.sumScore >= resource.data.sumScore
            && request.resource.data.sumScore <= 100000000
            && stampedAndThrottled());
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // per-user aggregate totals (overall / per-sport / per-game sums of bests)
    // powering the combined leaderboards. Owner-only, validated, rate-limited.
    match /totals/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        // owner renaming themselves: only the name field may change
        || (signedIn() && request.auth.uid == uid
            && resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 40)
        // owner rolling up a finished run
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.overall is number
            && request.resource.data.overall >= 0 && request.resource.data.overall <= 10000000
            && request.resource.data.plays is number
            && request.resource.data.plays >= 0
            && request.resource.data.updated == request.time);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // daily-grid community answer counts: one doc per (grid, cell, player),
    // n may only ever step up by one per write.
    match /gridStats/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && id == request.resource.data.g + '_' + string(request.resource.data.cell) + '_' + request.resource.data.pid
        && request.resource.data.g is string && request.resource.data.g.size() <= 30
        && request.resource.data.cell is int
        && request.resource.data.cell >= 0 && request.resource.data.cell <= 8
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && ((resource == null && request.resource.data.n == 1)
            || (resource != null && request.resource.data.n == resource.data.n + 1));
      allow delete: if isAdmin();
    }

    // one daily-grid play per user per sport per day; immutable once written.
    match /gridPlays/{id} {
      allow read: if true;
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.sport + '_' + request.resource.data.date
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sport is string && request.resource.data.sport.size() <= 12
        && request.resource.data.date is string && request.resource.data.date.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 9
        && request.resource.data.rarity is number
        && request.resource.data.rarity >= 0 && request.resource.data.rarity <= 900
        && request.resource.data.cells is list && request.resource.data.cells.size() <= 9;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // per-sport Elo ratings (head-to-head ranked). Owner-only writes.
    // Ratings are bounded and may only move by a small step per write
    // (client K-factor is 24), so a client can't just set itself to 9999.
    function eloOk(f) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is number
            && request.resource.data[f] >= 100
            && request.resource.data[f] <= 3500
            && ((resource != null && f in resource.data && resource.data[f] is number)
                ? (request.resource.data[f] - resource.data[f] <= 50
                   && resource.data[f] - request.resource.data[f] <= 50)
                : (request.resource.data[f] >= 900 && request.resource.data[f] <= 1100)));
    }
    function gamesOk(f) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is number
            && request.resource.data[f] >= 0 && request.resource.data[f] <= 1000000);
    }
    match /elo/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'name', 'updated',
             'e_nfl', 'e_nba', 'e_mlb', 'e_nhl', 'e_cfb', 'e_soccer',
             'g_nfl', 'g_nba', 'g_mlb', 'g_nhl', 'g_cfb', 'g_soccer'])
        && eloOk('e_nfl') && eloOk('e_nba') && eloOk('e_mlb')
        && eloOk('e_nhl') && eloOk('e_cfb') && eloOk('e_soccer')
        && gamesOk('g_nfl') && gamesOk('g_nba') && gamesOk('g_mlb')
        && gamesOk('g_nhl') && gamesOk('g_cfb') && gamesOk('g_soccer');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // head-to-head rooms. A `players` map { uid: {name,streak,done,elo} } holds
    // live progress. The host owns the room config (and may only change it in
    // the lobby); each player may write ONLY their own entry in the players map
    // and never exceed the room cap. Seed/identities are immutable after create.
    // a player's own entry in the players map must look like the client's
    // { name, streak, done, elo } with sane bounds
    function playerEntryOk(p) {
      return p.keys().hasOnly(['name', 'streak', 'done', 'elo'])
        && p.name is string && p.name.size() >= 1 && p.name.size() <= 40
        && p.streak is number && p.streak >= 0 && p.streak <= 100000
        && p.done is bool
        && p.elo is number && p.elo >= 100 && p.elo <= 3500;
    }
    match /rooms/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "lobby"
        && request.resource.data.mode in ["higher-lower", "career-path"]
        && request.resource.data.sport is string && request.resource.data.sport.size() <= 12
        && request.resource.data.code is string && request.resource.data.code.size() <= 8
        && request.resource.data.seed is string && request.resource.data.seed.size() <= 64
        && request.resource.data.cap is int && request.resource.data.cap >= 2 && request.resource.data.cap <= 12
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && playerEntryOk(request.resource.data.players[request.auth.uid]);
      allow update: if signedIn() && (
        // host edits room config / starts, only while in the lobby
        (request.auth.uid == resource.data.hostUid
          && resource.data.status == "lobby"
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['mode', 'sport', 'cat', 'catLabel', 'seed', 'status', 'rated', 'cap', 'hostElo', 'startedAt'])
          && request.resource.data.mode in ["higher-lower", "career-path"]
          && request.resource.data.sport is string && request.resource.data.sport.size() <= 12
          && request.resource.data.seed is string && request.resource.data.seed.size() <= 64
          && request.resource.data.status in ["lobby", "active"]
          && request.resource.data.cap is int && request.resource.data.cap >= 2 && request.resource.data.cap <= 12)
        // any player writes ONLY their own players-map entry (join in lobby,
        // or progress once active); never exceeding the cap
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.players.keys().size() <= resource.data.cap
          && playerEntryOk(request.resource.data.players[request.auth.uid])
          && (resource.data.status == 'lobby' || resource.data.players.keys().hasAny([request.auth.uid])))
        // any participant may close out an active match (the client marks the
        // room done when the last player finishes)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'active'
          && request.resource.data.status == 'done'
          && request.auth.uid in resource.data.players)
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.hostUid == request.auth.uid);
    }

    // first-party usage counter (see /js/ebk-analytics.js): anonymous
    // {path, source, event, ts} docs, one per event, written by any visitor
    // (traffic measurement must work signed-out). No personal data. Reads are
    // admin-only so the raw stream is never public.
    match /hits/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['p', 's', 'e', 't'])
        && request.resource.data.p is string && request.resource.data.p.size() <= 100
        && request.resource.data.s is string && request.resource.data.s.size() <= 30
        && request.resource.data.e in ['view', 'start', 'finish']
        && request.resource.data.t is int && request.resource.data.t > 0;
    }

    // name reports: any signed-in user can file; only admins can read/resolve.
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() <= 40
        && request.resource.data.keys().hasOnly(
             ['targetUid', 'targetName', 'reporter', 'reporterName', 'reason', 'ts']);
      allow read, update, delete: if isAdmin();
    }
  }
}
